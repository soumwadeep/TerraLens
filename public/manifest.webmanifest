{
  "id": "/",
  "name": "TerraLens — AI Nature Companion",
  "short_name": "TerraLens",
  "description": "An offline-first AI field companion that helps you notice more, explore farther, and spend less time looking at your screen.",
  "start_url": "/home",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f7f6f1",
  "theme_color": "#f7f6f1",
  "categories": ["lifestyle", "health", "education", "travel"],
  "lang": "en",
  "dir": "ltr",
  "icons": [
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Journal",
      "short_name": "Journal",
      "description": "Your expeditions, observations and Grass Score history",
      "url": "/journal",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Grass Score",
      "short_name": "Score",
      "description": "How much time you spent outside, not on a screen",
      "url": "/score",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Start an expedition",
      "short_name": "Go outside",
      "description": "Begin a new field expedition",
      "url": "/expeditions/new",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
