# =============================================================================
# TerraLens environment configuration
# =============================================================================
# Everything here is OPTIONAL. TerraLens boots and works as a fully local,
# offline-first companion with NO environment variables configured.
#
# Rules:
#   - Never commit real secrets. Copy this file to .env.local and fill in.
#   - Every integration is activated ONLY when its configuration is present
#     AND a health check passes. Existence of a variable alone is never
#     reported as "READY" (see /lab/models and the integration registry).
#   - Deriving state from configuration is centralized in src/lib/config.
# =============================================================================

# -----------------------------------------------------------------------------
# APP
# -----------------------------------------------------------------------------
# Public base URL of the deployed app (used for share links, Temporal callbacks).
# NEXT_PUBLIC_APP_URL=https://terralens.onrender.com

# -----------------------------------------------------------------------------
# AI — GEMMA (open-weight field intelligence)
# -----------------------------------------------------------------------------
# TerraLens speaks the OpenAI-compatible chat API, which is served by many
# open-weight runtimes: Ollama, llama.cpp server, vLLM, LM Studio, TGI, or
# Google's hosted Gemma endpoints. Point GEMMA_BASE_URL at any of them.
#
# Example (Ollama on the same machine):
#   GEMMA_BASE_URL=http://127.0.0.1:11434/v1
#   GEMMA_MODEL=gemma3:4b
#   GEMMA_API_KEY=ollama            # Ollama ignores the value
#
# Example (hosted OpenAI-compatible gateway):
#   GEMMA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   GEMMA_MODEL=gemma-3-27b-it
#   GEMMA_API_KEY=...
#
GEMMA_BASE_URL=
GEMMA_MODEL=gemma3:4b
GEMMA_API_KEY=
# Optional embeddings model (OpenAI-compatible POST {GEMMA_BASE_URL}/embeddings)
# enabling Tiger Data vector search. Unset → Postgres full-text search, and the
# API reports engine "lexical" instead of "pgvector".
GEMMA_EMBEDDING_MODEL=
# Hard timeout for a single inference call, milliseconds.
GEMMA_TIMEOUT_MS=45000

# Browser-side local inference (experimental): an OpenAI-compatible endpoint
# reachable FROM THE USER'S DEVICE (e.g. Ollama installed on their machine).
# When set, TerraLens can route observation analysis to the device itself.
# NEXT_PUBLIC_LOCAL_AI_URL=http://127.0.0.1:11434/v1
# NEXT_PUBLIC_LOCAL_AI_MODEL=gemma3:4b

# Optional self-hosted on-device model pack metadata for the Offline AI Pack UI.
# If unset, the download card shows "No offline pack configured" — never a
# fabricated size.
# NEXT_PUBLIC_LOCAL_MODEL_PACK_URL=
# NEXT_PUBLIC_LOCAL_MODEL_PACK_BYTES=
# NEXT_PUBLIC_LOCAL_MODEL_PACK_VERSION=

# -----------------------------------------------------------------------------
# MASTRA (field agent orchestration)
# -----------------------------------------------------------------------------
# Mastra orchestrates the Field Agent. It uses the Gemma endpoint above as the
# model backend. No separate credentials are required when GEMMA_* is set.
# Set this to 0 to force the deterministic workflow fallback (no LLM calls).
FIELD_AGENT_ENABLED=1

# -----------------------------------------------------------------------------
# TINKER (curiosity fine-tuning workspace)
# -----------------------------------------------------------------------------
# Only needed to run fine-tuning jobs in /ai/tinker/scripts. The app itself
# reads evaluation RESULTS from ai/tinker/evaluation/results.json, which is
# absent until you actually run an evaluation — the UI then says
# "Evaluation not run yet." instead of inventing numbers.
TINKER_API_KEY=
# TINKER_BASE_MODEL=meta-llama/Llama-3.1-8B
# TINKER_ADAPTER_NAME=terralens-curiosity-v1

# -----------------------------------------------------------------------------
# MONGODB ATLAS (user/expedition/observation storage + cloud sync)
# -----------------------------------------------------------------------------
# When unset, TerraLens runs guest/local-only; the app is fully functional and
# /lab shows "MongoDB: not configured". Server-side only — never exposed to clients.
MONGODB_URI=
# MONGODB_DB=terralens

# -----------------------------------------------------------------------------
# TIGER DATA / POSTGRES + PGVECTOR (nature knowledge retrieval)
# -----------------------------------------------------------------------------
# Separate knowledge system from MongoDB (per the architecture spec).
# When unset, retrieval uses the bundled field guide on the device
# (src/lib/knowledge/seed.json) and the app reports "not-configured" — it never
# pretends the server knowledge base answered.
#
# Setup: services/knowledge/README.md
#   psql "$TIGER_DATABASE_URL" -f services/knowledge/schema.sql
#   node --env-file=.env.local scripts/seed-tiger.mjs
TIGER_DATABASE_URL=
# Tiger Data Cloud connection string example:
# TIGER_DATABASE_URL=postgres://tsdbadmin:password@xyz.tsdb.cloud.timescale.com:3xxxx/tsdb?sslmode=require

# -----------------------------------------------------------------------------
# TEMPORAL (durable expedition workflows)
# -----------------------------------------------------------------------------
# Works with a local Temporal dev server (temporal server start-dev) or
# Temporal Cloud. When unset, expedition durability is handled by the local
# sync queue only and /lab shows "Temporal: not configured".
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=terralens-expeditions
# For Temporal Cloud:
# TEMPORAL_API_KEY=
# TEMPORAL_TLS=1

# -----------------------------------------------------------------------------
# ELEVENLABS (pocket mode voice)
# -----------------------------------------------------------------------------
# Server-side only. Proxied through /api/voice so the key never reaches the
# browser. Without it, TerraLens uses the built-in browser SpeechSynthesis
# provider — voice degrades, it never breaks.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2

# -----------------------------------------------------------------------------
# SERPAPI (optional online verification / enrichment)
# -----------------------------------------------------------------------------
# Used ONLY to find additional public context for an observation — never as
# the identification engine. Results are labelled "ONLINE CONTEXT".
SERPAPI_API_KEY=

# -----------------------------------------------------------------------------
# TABPFN (exploration forecast prediction service)
# -----------------------------------------------------------------------------
# URL of the Python prediction service in /services/prediction (or a hosted
# TabPFN deployment). When unset — or when the service has no trained
# artifact — the forecast card says so honestly; it never shows invented numbers.
PREDICTION_SERVICE_URL=
# Shared secret the service and app must agree on (header x-terralens-key).
PREDICTION_SERVICE_KEY=
# Where the trained joblib artifact lives (inside services/prediction).
# TABPFN_MODEL_PATH=artifacts/activity_predictor.joblib

# -----------------------------------------------------------------------------
# BACKBOARD (long-term memory)
# -----------------------------------------------------------------------------
# Optional long-term agent memory. LocalMemoryProvider (IndexedDB) always
# works; BackboardMemoryProvider activates when configured and reachable.
# BACKBOARD_API_URL defaults to https://app.backboard.io/api when a key is set.
BACKBOARD_API_URL=
BACKBOARD_API_KEY=
# The assistant that owns the memory store (create one at app.backboard.io).
BACKBOARD_ASSISTANT_ID=

# -----------------------------------------------------------------------------
# SENTRY (agent tracing / observability)
# -----------------------------------------------------------------------------
# Without a DSN, Sentry is a no-op and /lab/observability uses local ring
# buffers instead. Observation content and precise coordinates are redacted
# before anything leaves the process (see src/lib/telemetry).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# AUTH (optional cloud accounts — guest/local mode needs none of this)
# -----------------------------------------------------------------------------
# 32+ char random string used to sign session cookies.
AUTH_SECRET=
# Session lifetime in days.
AUTH_SESSION_DAYS=30

# -----------------------------------------------------------------------------
# FEATURE FLAGS (all optional; sensible defaults derived from configuration)
# -----------------------------------------------------------------------------
# Set to 0 to force-disable an integration even when credentials exist.
ENABLE_SERVER_AI=1
ENABLE_ELEVENLABS=1
ENABLE_TABPFN=1
ENABLE_BACKBOARD=1
ENABLE_SERPAPI=1
ENABLE_TIGER=1
ENABLE_TEMPORAL=1
ENABLE_MONGODB=1
